{"session_id": "62ef2182-bbbf-4cee-bf1f-e268348b0f2c", "start_time": 0.0, "end_time": 0.5, "raw_text": "こんにちは。", "text": "아/ 그래?"}
{"session_id": "62ef2182-bbbf-4cee-bf1f-e268348b0f2c", "start_time": 0.5, "end_time": 1.0, "raw_text": "", "text": ""}
{"session_id": "62ef2182-bbbf-4cee-bf1f-e268348b0f2c", "start_time": 1.0, "end_time": 1.5, "raw_text": "해세를 한 다음에 얘도 찾을 수 있습니다.", "text": "해세를 한 다음에 얘도 찾을 수 있어."}
{"session_id": "62ef2182-bbbf-4cee-bf1f-e268348b0f2c", "start_time": 1.5, "end_time": 2.0, "raw_text": "지금요", "text": "지금이야."}
{"session_id": "62ef2182-bbbf-4cee-bf1f-e268348b0f2c", "start_time": 2.0, "end_time": 2.5, "raw_text": "", "text": ""}
{"session_id": "62ef2182-bbbf-4cee-bf1f-e268348b0f2c", "start_time": 2.5, "end_time": 3.0, "raw_text": "이승진 이승진", "text": "이승진+ 이승진."}
{"session_id": "62ef2182-bbbf-4cee-bf1f-e268348b0f2c", "start_time": 3.0, "end_time": 3.5, "raw_text": "이승현입니다.", "text": "이승현입니다."}
{"session_id": "62ef2182-bbbf-4cee-bf1f-e268348b0f2c", "start_time": 3.5, "end_time": 4.0, "raw_text": "지니의 의미. 이 순신", "text": "지니 의미 이 순신."}
{"session_id": "62ef2182-bbbf-4cee-bf1f-e268348b0f2c", "start_time": 4.0, "end_time": 4.5, "raw_text": "KABUKZAN", "text": "KABKYAN."}
{"session_id": "62ef2182-bbbf-4cee-bf1f-e268348b0f2c", "start_time": 4.5, "end_time": 5.0, "raw_text": "", "text": ""}
{"session_id": "62ef2182-bbbf-4cee-bf1f-e268348b0f2c", "start_time": 5.0, "end_time": 5.5, "raw_text": "이순신 거북선", "text": "이순신 거북선."}
