{"session_id": "e848e18e-0fc1-42d3-aa2b-cc3a825c1ce5", "start_time": 26.0, "end_time": 26.5, "raw_text": "감사합니다.", "text": "감사합니다."}
{"session_id": "e848e18e-0fc1-42d3-aa2b-cc3a825c1ce5", "start_time": 26.5, "end_time": 27.0, "raw_text": "", "text": ""}
{"session_id": "e848e18e-0fc1-42d3-aa2b-cc3a825c1ce5", "start_time": 27.0, "end_time": 27.5, "raw_text": "이거 리코드 그레스", "text": "이거 리코드 그레스."}
